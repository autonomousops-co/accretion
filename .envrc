# Accretion — direnv environment (checked in). Sets non-secret dev config.
# Secrets are NOT here; they live in a gitignored .env (see env.example).
# After cloning:  cp env.example .env  →  fill in secrets  →  direnv allow

# --- Go toolchain (project-local GOPATH) ---
export GOPATH="$PWD/.gopath"
export GOBIN="$GOPATH/bin"
export GOMODCACHE="$GOPATH/pkg/mod"
PATH_add "$GOBIN"

# --- Server ---
export ACCRETION_SERVER_HOST=0.0.0.0
# Two listeners. The API is what accretion-mcp, the Discord bot and curl talk to;
# the UI is the browser surface and is off by default. Ports are independent so
# exposing one never exposes the other.
export ACCRETION_API_PORT=${ACCRETION_API_PORT:-41337}
export ACCRETION_UI_PORT=${ACCRETION_UI_PORT:-8080}

# --- TLS ---
# The API listener terminates TLS in-process. `make up` writes the CA that
# signed the local certificate to .tls/ca.crt (the api-ca-cert resource), and
# every client — accretion-mcp, the functional tests, preflight, curl — reads
# this variable and VERIFIES against it. Nothing in this project skips
# verification; if this path is missing, bring the stack up rather than
# reaching for an insecure flag.
export ACCRETION_API_CA_FILE=${ACCRETION_API_CA_FILE:-$PWD/.tls/ca.crt}
export ACCRETION_API_URL=${ACCRETION_API_URL:-https://localhost:41337}

# --- Database (local dev defaults; override in .env for non-local) ---
# The PASSWORD is a SECRET -> set ACCRETION_DATABASE_PASSWORD in .env. This file
# exported `postgres` until #134, so the same working password sat here, in six
# checked-in values files, and in whatever .env had not overridden it. It is now
# the single input scripts/make-secret.sh publishes as the db-password and
# postgres-password Secret keys, so every chart reads it through a secretKeyRef
# and nothing checked in carries the value. As with the auth block below, the
# name is documented here and the value lives only in .env — see env.example.
export ACCRETION_DATABASE_HOST=localhost
export ACCRETION_DATABASE_PORT=5432
export ACCRETION_DATABASE_USER=postgres
export ACCRETION_DATABASE_DATABASE=accretion
export ACCRETION_DATABASE_SSLMODE=disable

# --- LLM provider: "ollama", "openai", or "anthropic" ---
export ACCRETION_LLM_PROVIDER=ollama
export ACCRETION_LLM_OPENAI_BASE_URL=https://api.openai.com/v1
export ACCRETION_LLM_OPENAI_MODEL=gpt-4
export ACCRETION_LLM_OLLAMA_BASE_URL=http://localhost:11434
export ACCRETION_LLM_OLLAMA_MODEL=llama3
export ACCRETION_LLM_EMBEDDING_MODEL=nomic-embed-text:latest
export ACCRETION_LLM_CHAT_MODEL=claude-sonnet-5

# --- Kubernetes (empty config path = in-cluster config) ---
export ACCRETION_K8S_CONFIG_PATH=
export ACCRETION_K8S_NAMESPACES=default
# Event collector poll period; status collectors' informer resync period (#96).
export ACCRETION_K8S_POLL_INTERVAL=30s

# --- Logging: level = debug|info|warn|error ; format = json|text ---
export ACCRETION_LOGGING_LEVEL=info
export ACCRETION_LOGGING_FORMAT=json
export ACCRETION_LOGGING_FRONTEND_LEVEL=info

# --- Auth (non-secret settings). Client id/secret, session key, and MCP API
#     keys are SECRETS → set them in .env. Empty whitelists let the GCP OAuth
#     consent screen gate access. ---
# The callback is served by the UI listener, so it follows ACCRETION_UI_PORT.
export ACCRETION_AUTH_OAUTH_REDIRECT_URL=http://localhost:${ACCRETION_UI_PORT}/auth/callback
export ACCRETION_AUTH_ALLOWED_EMAILS=
export ACCRETION_AUTH_ALLOWED_DOMAINS=
export ACCRETION_AUTH_ADMIN_EMAILS=
export ACCRETION_AUTH_ADMIN_DOMAINS=
export ACCRETION_AUTH_COOKIE_SECURE=false
export ACCRETION_AUTH_COOKIE_DOMAIN=

# --- Per-client API keys. SECRETS -> set them in .env. ---
# ACCRETION_API_KEY_MCP, ACCRETION_API_KEY_DISCORD and ACCRETION_API_KEY_CI are
# the plaintexts each machine caller sends; the chart's apiKeys list carries only
# their SHA-256 digests. They were checked into values-dev.yaml until #122. As
# with the auth block above, the names are documented here and the values live
# only in the gitignored .env — see env.example.

# --- MCP client CA pointer (non-secret, but per-cluster) ---
# ACCRETION_API_CA_CONFIGMAP names a CA-only ConfigMap for accretion-mcp-secrets
# to point at instead of the serving Secret, which also holds the listener's
# private key. Left unset here because there is no such ConfigMap in the local
# kind stack by default; set it in .env if you publish one. See env.example.

# --- Secrets + local overrides from .env (gitignored). Loaded last so .env wins. ---
dotenv_if_exists .env

# --- Optional per-machine overrides (gitignored) ---
source_env_if_exists .envrc.local
