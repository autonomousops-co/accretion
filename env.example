# Accretion secrets — copy to .env (gitignored) and fill in real values:
#     cp env.example .env
# Non-secret config lives in .envrc (checked in). Values set here also override
# the .envrc defaults, since .envrc loads this via `dotenv_if_exists .env`.
#
# Each variable below is annotated with the key it becomes in the
# `accretion-api-secrets` Kubernetes Secret. The two conventions differ — .env is
# SHELL_CASE, the chart's secretKeyRefs are dashed-lowercase — so translate with
# the one mapping rather than by hand:
#
#     scripts/make-secret.sh --namespace accretion-core     # or: make secrets
#     make secrets-check                                   # proves the keys match
#
# `kubectl create secret generic --from-env-file=.env` does NOT work: it writes
# keys the chart never reads, and the only symptom is a 401 on every request.
# Variables annotated "not in accretion-api-secrets" are consumed elsewhere
# (Tilt, the Discord bot's own chart Secret).
#
# Keep annotations on their own lines: this file is parsed as plain KEY=VALUE by
# direnv, the Tiltfile, and make-secret.sh, none of which strip a trailing
# `# comment` — it would end up inside the value.

# --- LLM provider keys ---
# Secret key: openai-api-key
ACCRETION_LLM_OPENAI_API_KEY=your-openai-api-key-here
# Not in accretion-api-secrets (accretion-discord chart Secret).
ACCRETION_LLM_ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Discord bot ---
# Not in accretion-api-secrets (accretion-discord chart Secret).
DISCORD_BOT_TOKEN=your-discord-bot-token-here
# Optional: restrict the bot to a single guild. Leave empty for all guilds.
DISCORD_GUILD_ID=

# --- Auth: Google OAuth + session ---
# These three are REQUIRED: their secretKeyRefs are not `optional: true`, so a
# missing value fails the pod at rollout instead of 401ing every request later.
# Secret key: oauth-client-id
OAUTH_CLIENT_ID=your-google-client-id-here
# Secret key: oauth-client-secret
OAUTH_CLIENT_SECRET=your-google-client-secret-here
# Secret key: session-key — hex ONLY, at least 64 hex characters (32 bytes).
# Generate with: openssl rand -hex 32
# `openssl rand -hex 16` is 32 characters but decodes to 16 bytes, and is rejected.
SESSION_KEY=replace-me-openssl-rand-hex-32

# --- Per-client API keys ---
# One key per machine caller. These used to be checked in as plaintext `key`
# entries in charts/accretion-api/values-dev.yaml, from which the chart derived
# both halves; #122 moved the plaintext here, where every other local secret
# already lives, so that no working credential ships in the repository.
#
# That deliberately splits one input into two that can now disagree: the
# plaintext below is what the CLIENT sends, and a SHA-256 `hash` in the chart's
# apiKeys list is what the SERVER compares against. `make secrets-identity-check`
# is the gate that holds them together — it recomputes each digest from this file
# and fails on any identity where the two do not match, because the symptom
# otherwise is a 401 with nothing anywhere saying why.
#
# Generate a key and print the hash line to paste into the identities file:
#     openssl rand -hex 32
#     scripts/make-secret.sh --print-identities
#
# Left EMPTY here on purpose. A working credential in a checked-in file is the
# defect this replaced, so a fresh clone deliberately holds none: set your own.
# accretion-mcp-secrets data key: ACCRETION_API_KEY (the MCP client's credential).
ACCRETION_API_KEY_MCP=
# Not in accretion-api-secrets (read by the Discord bot as an API client).
ACCRETION_API_KEY_DISCORD=
# Not in accretion-api-secrets (read-only key for CI and the functional suite).
ACCRETION_API_KEY_CI=

# --- Auth: who is allowed in ---
# Set AT LEAST ONE of these four. An empty whitelist means "allow every
# authenticated user", so leaving them all unset with OAuth configured would let
# any Google account on the internet through. The server refuses to start in
# that state rather than come up silently open, so an omission is a failed
# rollout, not a breach.
# Secret key: accretion-auth-allowed-emails
ACCRETION_AUTH_ALLOWED_EMAILS=you@example.com
# Secret key: accretion-auth-allowed-domains
# ACCRETION_AUTH_ALLOWED_DOMAINS=example.com
# Secret key: accretion-auth-admin-emails
# ACCRETION_AUTH_ADMIN_EMAILS=you@example.com
# Secret key: accretion-auth-admin-domains
# ACCRETION_AUTH_ADMIN_DOMAINS=example.com

# --- Database ---
# REQUIRED, and it is the only place this value exists. Six checked-in values
# files shipped `postgres` until #134, so a default install stood up a database
# whose password is public knowledge; the charts now carry none and refuse to
# render without one rather than falling back to a working default. This single
# variable becomes every copy of it: scripts/make-secret.sh writes it to
# db-password in accretion-api-secrets (read by accretion-api and every
# collector) and to db-password AND postgres-password in accretion-db-secrets in
# the accretion-db namespace (read by the schema job, the partition cronjob, and
# the Postgres server itself). One input, so no two of them can disagree.
# Secret key: db-password
ACCRETION_DATABASE_PASSWORD=replace-me-openssl-rand-hex-16

# --- Optional overrides (uncomment for non-local / production) ---
# Secret key: accretion-auth-oauth-redirect-url
# ACCRETION_AUTH_OAUTH_REDIRECT_URL=https://your-host/auth/callback
# Secret key: accretion-auth-cookie-secure
# ACCRETION_AUTH_COOKIE_SECURE=true
# Secret key: accretion-auth-cookie-domain
# ACCRETION_AUTH_COOKIE_DOMAIN=example.com
# Secret key: accretion-logging-frontend-level
# ACCRETION_LOGGING_FRONTEND_LEVEL=warn
# ACCRETION_DATABASE_SSLMODE=require
# ACCRETION_LOGGING_LEVEL=warn

# --- MCP client CA pointer (optional, least privilege) ---
# scripts/make-secret.sh puts a POINTER to the API's CA into accretion-mcp-secrets
# rather than a copy. By default it points at the serving Secret, which ALSO holds
# the listener's private key -- Kubernetes RBAC cannot narrow a read to one key of
# an object, so every MCP user would get `get` on that key. Name a CA-only
# ConfigMap here instead (cert-manager's trust-manager publishes one) and they
# need no access to it. Accepts "name" or "namespace/name".
# Not in accretion-api-secrets (read into accretion-mcp-secrets).
# ACCRETION_API_CA_CONFIGMAP=accretion-ca

# --- TLS to the API (optional) ---
# .envrc already points these at the local `make up` cluster. Override them to
# reach a different deployment: ACCRETION_API_CA_FILE is the CA that signed that
# API's certificate, and is unnecessary for a publicly-trusted one.
# ACCRETION_API_URL=https://accretion-api.example.com
# ACCRETION_API_CA_FILE=/path/to/ca.crt
