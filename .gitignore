.gopath/
build/
.cache/
.env
.env.*
# ...but not a dependency's own fixtures. These patterns match at any depth, so
# they were silently excluding vendor/github.com/subosito/gotenv/.env from the
# repository: `go mod vendor` recreates it, so the committed tree never matched
# a freshly vendored one, and CI reported the vendor tree as stale on every run.
!vendor/**/.env
!vendor/**/.env.*
.envrc.local
# Optional local Tilt overrides; the Tiltfile carries the defaults (#101).
tilt_config.json
.DS_Store

# Editor scratch files. Not ignored until now, so a stray .swp in the tree was
# committable -- and `git add .` is how that happens.
*.swp
*.swo
*~
.idea/
.claude/worktrees/
tmp/
.claude
/accretion-api
/accretion-mcp
/.agents/
# Generated by `accretion generate config`. It carries no secret (#129), but it
# is the file an operator pastes real values into.
.accretion-*.yaml

# Local TLS material, written by `make up` (Tilt's api-ca-cert resource). It is
# regenerated per cluster and must never be committed.
.tls/

# An operator's live stack config. pulumi/scripts/deploy.sh copies the
# placeholder stacks/Pulumi.<stack>.yaml here on stack init and the operator
# substitutes their own GCP project, cluster and domain into it (#128). Those
# belong to them, not to this repository. The project file pulumi/Pulumi.yaml
# is unaffected: this pattern needs two dots and that name has one.
pulumi/Pulumi.*.yaml

# The Pulumi program's compiled binary, built by the deploy script. Nothing else
# in the tree ignored it, so a deploy left it staged for whoever committed next.
pulumi/accretion-infrastructure
